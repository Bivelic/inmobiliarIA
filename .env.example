# Copia este archivo como .env y completa los valores.
# El .env real NO se sube al repositorio (está en .gitignore).

# Conexión a PostgreSQL.
# Opción A, base local con Docker (docker compose up -d; expone el puerto 5433):
DATABASE_URL=postgresql://inmobiliaria:inmobiliaria@localhost:5433/inmobiliaria
# Opción B, base en Neon (copiar desde el panel de Neon, "Connection string"):
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Orígenes que pueden llamar a la API (frontend local y desplegado), separados por coma.
CORS_ORIGINS=http://localhost:5173

# Correo de contacto que va en el User-Agent de los scrapers (cortesía con los portales).
SCRAPER_CONTACTO=equipo-inmobiliaria@ejemplo.cl

# --- IA: extracción de atributos (docs/IA_EXTRACCION.md) ---
# Proveedores en orden de preferencia: si el primero responde "límite excedido", se usa el siguiente.
IA_PROVEEDORES=gemini,groq
# Gemini (gratis): crear la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
IA_MODELO_GEMINI=gemini-3.1-flash-lite
# Groq (gratis, respaldo): crear la clave en https://console.groq.com/keys
GROQ_API_KEY=
IA_MODELO_GROQ=openai/gpt-oss-120b

# --- Correo a Aurora por cada solicitud de contacto (Resend, plan gratis) ---
# Crear la cuenta de Resend con el correo que recibirá los avisos y la clave en https://resend.com/api-keys
# Sin dominio verificado, Resend solo envía al correo de la cuenta: LEADS_CORREO_DESTINO debe ser ese.
RESEND_API_KEY=
LEADS_CORREO_DESTINO=aurorapropiedades0@gmail.com
