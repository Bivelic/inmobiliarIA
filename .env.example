# Copia este archivo como .env y completa los valores.
# El .env real NO se sube al repositorio (está en .gitignore).

# Conexión a PostgreSQL.
# Opción A, base local con Docker (docker compose up -d):
DATABASE_URL=postgresql://inmobiliaria:inmobiliaria@localhost:5432/inmobiliaria
# Opción B, base en Neon (copiar desde el panel de Neon, "Connection string"):
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Orígenes que pueden llamar a la API (frontend local y desplegado), separados por coma.
CORS_ORIGINS=http://localhost:5173

# Correo de contacto que va en el User-Agent de los scrapers (cortesía con los portales).
SCRAPER_CONTACTO=equipo-inmobiliaria@ejemplo.cl
